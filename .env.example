PORT=8080
DATABASE_PATH=/data/squadslot.db
TZ=Europe/London
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_URL=http://localhost:8080
PUSH_SUBJECT=
DISCORD_WEBHOOK_URL=
DISCORD_BOT_NAME=SquadSlot
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
AUTO_BACKUP_ENABLED=false
# Required for all new backups. Generate a separate secret with openssl rand -hex 32.
# Keep a recovery copy outside the server; old backups require their original key.
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
TRUST_PROXY=0
# Exact LAN IP of the cloudflared server. Leave empty for direct access only.
# Example for this deployment: TRUSTED_TUNNEL_IPS=192.168.1.196
TRUSTED_TUNNEL_IPS=
# Old logs are pruned at startup and every five minutes. Back up needed history first.
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_ROWS=20000
DELIVERY_RETENTION_DAYS=90
# Admin/server-log warnings trigger below either free-space threshold.
STORAGE_WARNING_MB=1024
STORAGE_WARNING_PERCENT=10
